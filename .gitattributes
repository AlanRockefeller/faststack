# Normalize line endings to LF on commit (working tree may still be CRLF on
# Windows mounts). The `text eol=lf` attributes below do the CRLF->LF
# conversion themselves, so no custom clean filter is needed.
* text=auto eol=lf


# Explicitly treat these as text
*.py   text eol=lf
*.sh   text eol=lf
*.bash text eol=lf
*.fish text eol=lf
*.qml  text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.ini  text eol=lf
*.cfg  text eol=lf


# Keep binaries untouched (no eol conversions)
*.png  binary
*.jpg  binary
*.jpeg binary
*.tif  binary
*.tiff binary
*.webp binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.7z   binary
*.gz   binary
*.bz2  binary
*.xz   binary
*.whl  binary
*.so   binary
*.dll  binary
*.dylib binary
*.nef  binary
*.cr2  binary
*.cr3  binary
*.arw  binary
*.dng  binary
*.orf  binary
*.rw2  binary
*.raf  binary
*.heic binary
*.mp4  binary
*.mov  binary

